# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string — requires a local PostgreSQL instance
# Create the DB manually: createdb forge_db
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/forge_db"

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET="replace-with-a-secure-random-string-min-32-chars"
# Token expiry — e.g. 7d, 24h, 1h
JWT_EXPIRES_IN="7d"

# ─── Session ──────────────────────────────────────────────────────────────────
# Name of the HTTP-only session cookie
SESSION_COOKIE_NAME="forge_session"
# Secure cookie flag — set to true in production (requires HTTPS)
SESSION_COOKIE_SECURE="false"

# ─── Socket.io ────────────────────────────────────────────────────────────────
# Port the Socket.io server listens on
SOCKET_PORT="3001"
# CORS origin allowed for socket connections
SOCKET_CORS_ORIGIN="http://localhost:3000"

# ─── Application ──────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
# Public URL — used for absolute URL generation
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Forgie (AI Assistant) — optional, enables the in-app chatbot ────────────
# Set ASSISTANT_ENABLED=false to disable the whole feature.
# Each *_API_KEYS variable is a COMMA-SEPARATED list of API keys.
# Forgie rotates within a provider and falls back across providers.

ASSISTANT_ENABLED="false"

# Sign up free at https://console.groq.com (key starts with gsk_)
GROQ_API_KEYS=""
# Sign up free at https://aistudio.google.com/app/apikey (key starts with AIza)
GEMINI_API_KEYS=""
# Sign up free at https://cloud.cerebras.ai (key starts with csk-)
CEREBRAS_API_KEYS=""

# Provider preference (comma-separated). Forgie tries them in this order.
ASSISTANT_PROVIDER_ORDER="groq,gemini,cerebras"

# Default models per provider
GROQ_MODEL="llama-3.3-70b-versatile"
GEMINI_MODEL="gemini-flash-latest"
CEREBRAS_MODEL="gpt-oss-120b"

# Soft rate-limit per user (messages per hour)
ASSISTANT_USER_MSG_PER_HOUR="30"

# Shared secret for cron-driven endpoints (daily-log drafts, standup digest,
# project-health watchdog). External cron services (cron-job.org, GitHub
# Actions) hit /api/cron/* and must include header: x-cron-secret: <value>.
# Use a long random string in production.
CRON_SECRET=""

# ─── GitHub integration (optional) ────────────────────────────────────────────
# When both are set, Forgie can read repos/commits/PRs/issues/code/files and
# (with user confirmation) create new repos or file issues.
# Token: fine-grained PAT, resource owner = your org, repo access = all repos,
#   permissions = Contents/Issues read+write, Pull requests read, Metadata read,
#   Administration read+write (only needed for create-repo).
# Create at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=""
GITHUB_ORG=""

# ─── Google Calendar + Meet integration (optional) ────────────────────────────
# When all three are set, employees can click "Connect Google" on their profile
# to let Forgie schedule meetings, find shared free time, and auto-generate
# Meet links on their behalf.
#
# Setup:
#   1. Google Cloud Console → enable Calendar API
#   2. Create OAuth 2.0 Web Application credentials
#   3. Add authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
#   4. Copy Client ID + Secret here
#
# Required scopes (configured in the OAuth consent screen):
#   calendar.events, calendar.freebusy, openid email profile
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Hidden developer dashboard (/dashboard/dev) access allowlist.
# Comma-separated emails, case-insensitive. NOT tied to role.
DEV_DASHBOARD_EMAILS=

# Extra companies for the dev console's cross-company switcher (beyond the
# built-in rig360 + trijya). JSON array of objects:
#   { "id", "label", "schema", "organizationId"?, "databaseUrl"? }
# Omit databaseUrl to reuse DATABASE_URL with the schema swapped (same DB, other
# schema). Set databaseUrl for a company that lives on its own database.
# Example: [{"id":"trijya","label":"TRIJYA FORGE","schema":"public","organizationId":"trijya"}]
DEV_INSTANCES=

# ─── NAS integration (optional, Trijya-only) ──────────────────────────────────
# Base URL of the Trijya NAS connector (Python+pysmb service fronted by a
# Cloudflare Tunnel). Only enabled when the caller's org === NAS_ORG_ID.
TRIJYA_NAS_BASE_URL=""
NAS_ORG_ID="trijya"
# Cloudflare Access service token gating the tunnel, if configured.
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# ─── NAS content search (RAG) — optional ──────────────────────────────────────
# When both HF_API_KEY and QDRANT_URL are set, files uploaded via /api/nas/upload
# are chunked, embedded, and indexed in Qdrant so Forgie can search file CONTENT
# (nas_semantic_search), not just filenames. Leave unset to disable — uploads
# still work, just without content indexing.
#
# Hugging Face Inference API token — https://huggingface.co/settings/tokens
HF_API_KEY=""
# Any sentence-transformers feature-extraction model; must match HF_EMBEDDING_DIM.
HF_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
HF_EMBEDDING_DIM="384"
# Qdrant instance URL (self-hosted or Qdrant Cloud free tier) + API key.
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="nas_documents"

# ─── Trijya bylaws content search (RAG) — optional, separate index ────────────
# A fully separate pipeline from the one above: files under a NAS drive's
# "utility data/By_Laws" folder (found automatically, no fixed server label)
# go into their own Qdrant collection instead, searchable via a dedicated
# `bylaws_search` tool. Note "Trijya Projects" is the SMB SHARE name, so it is
# NOT part of the path. Uses the SAME HF_API_KEY/QDRANT_URL above — only the
# collection differs. New uploads to that folder auto-index; files already on
# the NAS need a one-time backfill: POST /api/nas/bylaws/reindex (admin-only).
QDRANT_BYLAWS_COLLECTION="trijya_bylaws"

# ─── RAG tuning (both pipelines) — all optional, defaults shown ───────────────
# Files bigger than this are skipped and recorded as FAILED with the reason,
# rather than parsed. Sized for Render's FREE plan (512 MB for the whole app);
# PDF parsing holds a multiple of the file in memory. Raise on a bigger plan.
RAG_MAX_FILE_MB="20"
# Max characters indexed per file (~300 pages). A file longer than this is
# indexed up to the limit and flagged with a warning, not silently cut.
RAG_MAX_TEXT_CHARS="1000000"
# Minimum cosine similarity for a passage to be returned. Calibrated for
# bge-small-en-v1.5 — re-calibrate if HF_EMBEDDING_MODEL changes.
RAG_MIN_SCORE="0.5"
# Max embedding requests in flight at once, across all uploads. Keeps bulk
# uploads under HuggingFace's free-tier rate limit.
HF_MAX_CONCURRENT="2"
# How long Forge waits for a connector extraction job (large PDFs over
# RAG_MAX_FILE_MB, and scanned PDFs that need OCR, are extracted ON the
# connector — see nasExtractText in lib/nas/client.ts). It is a job polled with
# short requests, so this is not limited by Cloudflare's ~100 s request cap.
# Giving up loses nothing: the connector keeps the result for an hour and the
# retry cron collects it.
NAS_EXTRACT_TIMEOUT_MS="900000"
# How often to poll an extraction job.
NAS_EXTRACT_POLL_MS="5000"
# How much a keyword match can boost a passage's rank above pure vector
# similarity (lib/rag/qdrant.ts's searchChunksHybrid) — fixes paraphrased
# queries ranking below exact-keyword near-misses. 0 disables the boost
# (pure vector ranking, the old behavior).
RAG_KEYWORD_BOOST_WEIGHT="0.15"

# ─── General-NAS backfill + staleness (optional, Trijya-only) ─────────────────
# Only files uploaded through Forge are content-indexed by default — most of
# the NAS's ~327k files arrived over SMB directly and are never touched. Set
# this to opt specific folders into POST /api/nas/reindex (admin-triggered
# backfill) and the stale-sweep cron below. Comma-separated "server:/path"
# pairs, e.g. WD:/01 ARCHITECTURE,WD:/Anjana. Leave unset to index nothing
# beyond Forge uploads (the original, pre-backfill behavior).
NAS_INDEX_FOLDERS=""
# Cap per listFilesRecursive call when scanning a NAS_INDEX_FOLDERS entry.
# Higher than the bylaws folder's default (2000) since these are meant to be
# "a few specific folders," not the whole NAS — keep folders small enough to
# list in full, or the sweep below can't tell "not reached yet" from "gone".
NAS_INDEX_MAX_FILES="20000"
# A tracked file not seen on a live NAS listing for this long is pruned from
# the index (app/api/cron/rag-stale-sweep). Set well above how often that
# route actually runs — one slow/partial crawl shouldn't cause a false prune.
RAG_STALE_GRACE_HOURS="48"
# Max FAILED/stuck-PENDING rows retried per run of app/api/cron/rag-retry.
# Keeps a retry sweep from itself hammering the free HF/Qdrant tiers.
RAG_RETRY_BATCH_SIZE="20"
# Attempts per file before the retry cron gives up (the row stays FAILED with
# its reason). Backoff between attempts: 15 min, 1 h, 4 h, 16 h, then 24 h.
RAG_RETRY_MAX_ATTEMPTS="6"
# A PENDING row older than this is treated as an interrupted index and retried.
RAG_RETRY_STUCK_MINUTES="30"
# Each retry run stops starting new files after this long.
RAG_RETRY_TIME_BUDGET_SECONDS="240"
# A backfill run with no heartbeat for this long counts as interrupted (server
# restarted) and no longer blocks a new run.
RAG_RUN_STALE_MINUTES="10"
